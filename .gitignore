# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
htmlcov/
.coverage
scratch/

# Virtual Environment
.venv/

# Environment Secrets — never commit real credentials
# Use .env.example (no secrets) as a template for contributors
.env

# Runtime logs — generated at startup, not source artifacts
*.log
api_startup.log

# Databases (regenerated at runtime)
*.db

# Vector storage (regenerated from source data)
qdrant_storage/

# Testing / Tooling Caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Large Data Sources (Stored locally, not in Git)
data/
synthetic_data_v2/

# IDE
.vscode/
.idea/
