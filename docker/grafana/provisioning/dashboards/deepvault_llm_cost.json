{
  "__inputs": [],
  "__elements": {},
  "__requires": [
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "bargauge", "name": "Bar gauge", "version": "" },
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.2.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "DeepVault — LLM cost tracking, token burn rate, and cost per query by strategy",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "currencyUSD",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.05 },
            { "color": "red", "value": 0.25 }
          ]},
          "mappings": []
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "auto" },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "deepvault_llm_cost_usd_total",
          "legendFormat": "Total Cost",
          "refId": "A"
        }
      ],
      "title": "💰 Total LLM Cost (USD)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 50000 },
            { "color": "red", "value": 200000 }
          ]}
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum(deepvault_llm_tokens_total)",
          "legendFormat": "Total Tokens",
          "refId": "A"
        }
      ],
      "title": "🔢 Total Tokens Consumed",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "unit": "currencyUSD",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.001 },
            { "color": "red", "value": 0.005 }
          ]}
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "deepvault_llm_cost_usd_total / (sum(deepvault_query_total{status='success'}) + 0.001)",
          "legendFormat": "Avg Cost / Query",
          "refId": "A"
        }
      ],
      "title": "💸 Average Cost per Query",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1000 },
            { "color": "red", "value": 2000 }
          ]}
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum(deepvault_llm_tokens_total) / (sum(deepvault_query_total{status='success'}) + 0.001)",
          "legendFormat": "Avg Tokens / Query",
          "refId": "A"
        }
      ],
      "title": "📊 Average Tokens per Query",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "id": 5,
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "rate(deepvault_llm_tokens_total{token_type='prompt'}[5m]) * 60",
          "legendFormat": "Prompt tokens/min",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "rate(deepvault_llm_tokens_total{token_type='completion'}[5m]) * 60",
          "legendFormat": "Completion tokens/min",
          "refId": "B"
        }
      ],
      "title": "🔥 Token Burn Rate (tokens/min)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "currencyUSD" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "id": 6,
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "rate(deepvault_llm_cost_usd_total[5m]) * 3600",
          "legendFormat": "Cost per hour (USD)",
          "refId": "A"
        }
      ],
      "title": "📈 LLM Cost Rate (USD/hour)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short",
          "custom": { "fillOpacity": 10 }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 13 },
      "id": 7,
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum(rate(deepvault_llm_tokens_total[5m])) by (retrieval_strategy) * 60",
          "legendFormat": "{{retrieval_strategy}} — tokens/min",
          "refId": "A"
        }
      ],
      "title": "🎯 Token Consumption by Retrieval Strategy",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["deepvault", "llm", "cost"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "DeepVault — LLM Cost & Token Analysis",
  "uid": "deepvault-llm-cost",
  "version": 1
}
